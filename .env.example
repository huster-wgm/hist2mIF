# Hugging Face token (needed for gated prov-gigatime/GigaTIME weights)
HF_TOKEN=

# HTTP server (FastAPI / Uvicorn)
HIST2MIF_HOST=0.0.0.0
HIST2MIF_PORT=7860

# Dev: auto-reload API process when Python files change (do not use in production)
# HIST2MIF_RELOAD=1

# Optional: comma-separated browser origins for CORS (empty or * = local dev defaults)
# HIST2MIF_CORS=http://127.0.0.1:5173,http://localhost:5173

# Where jobs + exports are stored (absolute path recommended on servers)
HIST2MIF_DATA=/home/ubuntu/gohiroaki/hist2mIF/data

# If HE slides are huge, downsample so longest side is at most this (pixels) before tiling
HIST2MIF_MAX_SIDE=8192
